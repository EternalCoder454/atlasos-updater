[Unit]
Description=Switch AtlasOS to the image this machine's hardware needs
Documentation=https://github.com/EternalCoder454/atlasos-updater
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/bin/bootc

[Service]
Type=oneshot
ExecStart=/usr/libexec/atlas-system-helper drivers
# One switch can download a whole image; bootc stages it atomically.
TimeoutStartSec=2h
# The state file is /var/lib/atlas-core/drivers.json (0644); the name of the
# directory is the one from before the package was atlas-system-helper.
StateDirectory=atlas-core
# Sandboxed like atlas-system-helper.service (see it for what is left off
# and why: bootc and ostree need /sysroot, /ostree and /etc writable, mount
# namespaces and CAP_SYS_PTRACE). Network access stays (registry pulls).
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_TIME CAP_SYS_BOOT CAP_SYS_RAWIO CAP_SYS_TTY_CONFIG CAP_WAKE_ALARM CAP_BLOCK_SUSPEND CAP_SYSLOG CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_NET_BROADCAST CAP_SYS_PACCT CAP_LEASE CAP_MAC_OVERRIDE CAP_CHECKPOINT_RESTORE CAP_BPF CAP_PERFMON
