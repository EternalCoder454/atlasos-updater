[Unit]
Description=Record the booted AtlasOS image in the update history
After=local-fs.target
ConditionPathExists=/usr/bin/bootc

[Service]
Type=oneshot
ExecStart=/usr/libexec/atlas-system-helper record-boot
StateDirectory=atlas-core
# The history must be readable by every user (see the helper, mode 0644).
# Sandboxed like the helper (see atlas-system-helper.service for what is left
# off and why; CAP_SYS_PTRACE stays for bootc). `bootc status` needs no
# network, so this one has none.
PrivateTmp=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_TIME CAP_SYS_BOOT CAP_SYS_RAWIO CAP_SYS_TTY_CONFIG CAP_WAKE_ALARM CAP_BLOCK_SUSPEND CAP_SYSLOG CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_NET_BROADCAST CAP_SYS_PACCT CAP_LEASE CAP_MAC_OVERRIDE CAP_CHECKPOINT_RESTORE CAP_BPF CAP_PERFMON

[Install]
WantedBy=multi-user.target
