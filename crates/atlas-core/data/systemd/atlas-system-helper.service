[Unit]
Description=Atlas system helper (runs bootc for Atlas apps)
Documentation=https://github.com/EternalCoder454/atlasos-updater

[Service]
Type=dbus
BusName=net.eterneon.atlas.SystemHelper
ExecStart=/usr/libexec/atlas-system-helper
# Sandboxed with the safe subset only. No ProtectSystem, PrivateMounts,
# PrivateDevices, RestrictNamespaces, RestrictSUIDSGID, MemoryDenyWriteExecute
# or NoNewPrivileges: bootc and ostree need mount namespaces, /sysroot, /ostree
# and /etc writable, setuid checkouts, immutable bits and SELinux transitions.
# CAP_SYS_PTRACE stays: bootc reads /proc/1/ns/mnt to enter the host mount
# namespace. Network access stays (registry pulls).
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_TIME CAP_SYS_BOOT CAP_SYS_RAWIO CAP_SYS_TTY_CONFIG CAP_WAKE_ALARM CAP_BLOCK_SUSPEND CAP_SYSLOG CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_NET_BROADCAST CAP_SYS_PACCT CAP_LEASE CAP_MAC_OVERRIDE CAP_CHECKPOINT_RESTORE CAP_BPF CAP_PERFMON
# The helper exits by itself after 60 seconds without calls.
#
# Stopping: the helper handles SIGTERM itself. It refuses new calls, releases
# its bus name and waits for a running bootc (up to 40 s), then asks bootc to
# stop. ostree pulls into its repo transactionally and stages a deployment
# atomically, so an interrupted bootc leaves the system as it was and the next
# run resumes; no shutdown inhibitor is needed. KillMode=mixed sends SIGTERM to
# the helper only and SIGKILL to leftovers when TimeoutStopSec runs out.
KillMode=mixed
TimeoutStopSec=60
