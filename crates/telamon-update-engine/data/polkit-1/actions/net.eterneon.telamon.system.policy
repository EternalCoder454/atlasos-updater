<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Eterneon</vendor>
  <vendor_url>https://github.com/EternalCoder454/atlasos-updater</vendor_url>

  <action id="net.eterneon.telamon.system.status">
    <description>Read the operating system update status</description>
    <message>Authentication is required to read the operating system update status</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="net.eterneon.telamon.system.check">
    <description>Check for operating system updates</description>
    <message>Authentication is required to check for operating system updates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="net.eterneon.telamon.system.upgrade">
    <description>Download and stage an operating system update</description>
    <message>Authentication is required to download and install an operating system update</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="net.eterneon.telamon.system.rollback">
    <description>Go back to the previous operating system version</description>
    <message>Authentication is required to go back to the previous operating system version</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="net.eterneon.telamon.system.switch-channel">
    <description>Change the operating system update channel</description>
    <message>Authentication is required to change the operating system update channel</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!-- The same five actions under the ids they had until 0.3.0, with the same
       defaults. A call to the helper through its old D-Bus name
       (net.eterneon.atlas.SystemHelper) is checked against these, so the
       polkit rules the OS image ships for them keep applying to the programs
       that have not moved yet. Remove with the old name. -->

  <action id="net.eterneon.atlas.system.status">
    <description>Read the operating system update status</description>
    <message>Authentication is required to read the operating system update status</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="net.eterneon.atlas.system.check">
    <description>Check for operating system updates</description>
    <message>Authentication is required to check for operating system updates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="net.eterneon.atlas.system.upgrade">
    <description>Download and stage an operating system update</description>
    <message>Authentication is required to download and install an operating system update</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="net.eterneon.atlas.system.rollback">
    <description>Go back to the previous operating system version</description>
    <message>Authentication is required to go back to the previous operating system version</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="net.eterneon.atlas.system.switch-channel">
    <description>Change the operating system update channel</description>
    <message>Authentication is required to change the operating system update channel</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
