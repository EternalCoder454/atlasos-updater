[Global]
IconName=net.eterneon.telamon.updater
Comment=Telamon Updater
Name=Telamon Updater
DesktopEntry=net.eterneon.telamon.updater

[Event/updateStaged]
Name=Update Ready
Comment=A Telamon OS update has been downloaded and is waiting for a restart
Action=Popup

[Event/appUpdatesReady]
Name=App Updates Ready
Comment=Updates for your apps are waiting for you to install them
Action=Popup

[Event/firmwareReady]
Name=Firmware Updates Ready
Comment=Firmware updates for your devices are waiting for you to install them
Action=Popup

[Event/restartSoon]
Name=Restart Coming Up
Comment=A scheduled restart to finish updating is about to happen
Action=Popup

[Event/crashReport]
Name=Crash Report Ready
Comment=A crash report is waiting for your review. Nothing is sent without your say-so
Action=Popup

[Event/restartFailed]
Name=Restart Did Not Happen
Comment=A scheduled restart could not be done or was missed
Action=Popup

[Event/driverStaged]
Name=Hardware Driver Changed
Comment=A graphics driver was installed or removed and needs a restart to finish
Action=Popup
